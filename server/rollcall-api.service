[Unit]
Description=Class roll call API (rollcall-api)
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/rollcall-api
ExecStart=/usr/bin/python3 /opt/rollcall-api/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:/opt/rollcall-api/logs/api.log
StandardError=append:/opt/rollcall-api/logs/api.error.log

[Install]
WantedBy=multi-user.target
