#include <windows.h>

#pragma code_page(65001)

/* 版本号由 build.ps1 从 src/main.c 的 APP_VERSION 生成，避免两处对不上 */
#include "version.h"

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION  VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "WhiteShadow Studio\0"
            VALUE "FileDescription",  "班级随机点名\0"
            VALUE "FileVersion",      VER_STR
            VALUE "InternalName",     "ClassRollCall\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 WhiteShadow Studio\0"
            VALUE "OriginalFilename", "ClassRollCall.exe\0"
            VALUE "ProductName",      "班级随机点名\0"
            VALUE "ProductVersion",   VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
